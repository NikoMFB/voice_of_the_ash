<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<style>
body{
  background:black;
  color:white;
  text-align:center;
  font-family:Arial;
}

button{
  font-size:22px;
  padding:15px 25px;
  margin-top:100px;
  cursor:pointer;
}

#character{
  display:none;
  width:350px;
  margin-top:20px;
}
</style>
</head>

<body>

<h1>У тебя есть сообщение 👀</h1>

<button id="startBtn">Открыть</button>

<video id="character" playsinline>
  <source src="video.webm" type="video/webm">
</video>

<audio id="voice">
  <source src="voice.wav" type="audio/wav">
</audio>

<script>
const btn = document.getElementById("startBtn");
const video = document.getElementById("character");
const voice = document.getElementById("voice");

btn.onclick = () => {

  btn.style.display="none";

  video.style.display="block";

  setTimeout(()=>{
     video.play();
     voice.play();
  },700);
};
</script>

</body>
</html>
